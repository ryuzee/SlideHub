<%# 文字起こし。ページ番号を押すと、そのページへ移る %>
<% if slide.transcript.try(:exist?) %>
  <% vertical = params[:vertical] == "1" %>
  <div class="slide_description">
    <% slide.transcript.lines.each_with_index do |line, index| %>
      <% text = clear_invisible_string(line) %>
      <% next if text.blank? %>
      <%= render 'slides/transcript_item', page: index + 1, text: text, prefix: prefix, vertical: vertical %>
    <% end %>
  </div>
<% else %>
  <p class="sh-empty"><%= t(:no_transcript) %></p>
<% end %>
