<%# スライドのカードを並べる。column_class を渡すと列幅を変えられる（サイドバーのあるページ用） %>
<% column_class = local_assigns[:column_class].presence || 'col-12 col-sm-6 col-lg-4 col-xl-3' %>
<div class="row g-4 slide-grid">
  <% slides.each do |slide| %>
    <% next if slide.nil? %>
    <div class="<%= column_class %>">
      <%= render 'slides/slide_card', slide: slide %>
    </div>
  <% end %>
</div>
