<%# スライド一覧のカード1枚。サムネイルの後ろに、ページ数に応じて紙が重なって見える。
    カスタム CSS が当てている slidecard 系のクラス名は変えないこと %>
<% title = strip_tags(slide.name) %>
<% pages = slide.num_of_pages.to_i %>
<% deck = pages >= 20 ? 2 : (pages >= 2 ? 1 : 0) %>
<article class="card slidecard" data-deck="<%= deck %>">
  <div class="slidecard-image">
    <%= link_to slide_path(slide.id), tabindex: -1, aria: { hidden: true } do %>
      <%= slide_thumbnail_tag(slide) %>
      <% if pages.positive? %><span class="slidecard-pages"><%= t(:pages_count, count: pages) %></span><% end %>
    <% end %>
  </div>
  <div class="slidecard-content">
    <div class="slidecard-title">
      <%= link_to title, slide_path(slide.id), title: title %>
    </div>
    <% description = strip_tags(slide.description).squish %>
    <% if description.present? %>
      <p class="slidecard-description"><%= description.truncate(140) %></p>
    <% end %>
    <div class="slidecard-information">
      <div class="slidecard-author">
        <%= link_to strip_tags(slide.user_display_name), user_by_username_path(username: slide.user_username) %>
        <% if slide.private %><span class="badge text-bg-secondary ms-1"><%= t(:private_slide) %></span><% end %>
      </div>
      <div class="slidecard-meta">
        <time datetime="<%= slide.created_at.iso8601 %>"><%= l(slide.created_at.to_date, format: t(:date_format_compact)) %></time>
        <span><%= t(:views_count, count: slide.total_view) %></span>
      </div>
    </div>
  </div>
</article>
