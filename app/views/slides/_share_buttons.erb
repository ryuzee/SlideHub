<%# 共有ボタン。ポップアップで各サービスの共有画面を開く %>
<% url = request.url %>
<div class="sh-share" role="group" aria-label="<%= t(:share) %>">
  <a class="btn btn-sh-quiet sh-icon-btn" href="https://twitter.com/intent/tweet?url=<%= CGI.escape url %>" target="_blank" rel="noopener noreferrer" title="X (Twitter)" aria-label="X (Twitter)" onclick="window.open('https://twitter.com/intent/tweet?text=' + encodeURIComponent(document.title) + '&url=' + encodeURIComponent(document.URL)); return false;"><i class="fa-brands fa-twitter" aria-hidden="true"></i></a>
  <a class="btn btn-sh-quiet sh-icon-btn" href="https://www.facebook.com/sharer/sharer.php?u=<%= CGI.escape url %>" target="_blank" rel="noopener noreferrer" title="Facebook" aria-label="Facebook" onclick="window.open('https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(document.URL)); return false;"><i class="fa-brands fa-facebook-f" aria-hidden="true"></i></a>
  <a class="btn btn-sh-quiet sh-icon-btn" href="https://www.linkedin.com/sharing/share-offsite/?url=<%= CGI.escape url %>" target="_blank" rel="noopener noreferrer" title="LinkedIn" aria-label="LinkedIn" onclick="window.open('https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(document.URL)); return false;"><i class="fa-brands fa-linkedin-in" aria-hidden="true"></i></a>
  <a class="btn btn-sh-quiet sh-icon-btn" href="mailto:?body=<%= CGI.escape url %>" title="<%= t(:share_by_email) %>" aria-label="<%= t(:share_by_email) %>" onclick="window.location.href='mailto:?subject=' + encodeURIComponent(document.title) + '&body=' + encodeURIComponent(document.URL); return false;"><i class="fa fa-envelope" aria-hidden="true"></i></a>
</div>
