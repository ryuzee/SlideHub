<% content_for :title, @slide.name %>
<% content_for :full_bleed, true %>
<% content_for :top_band, 'stage' %>
<% prefix = js_prefix %>
<% vertical = params[:vertical] == "1" %>
<% owner = user_signed_in? && current_user.id == @slide.user_id %>
<%= render 'slides/meta_tags', slide: @slide %>
<%= json_ld_tag(slide_structured_data(@slide)) %>
<%= json_ld_tag(slide_breadcrumb_structured_data(@slide)) %>

<%# スライドは暗いステージに映す %>
<section class="sh-stage sh-player-stage" aria-label="<%= t(:slide_player) %>">
  <div class="container">
    <% if vertical %>
      <div class="sh-player-vertical">
        <%= render 'slides/slide_vertical', slide: @slide, start_position: @start_position %>
      </div>
    <% else %>
      <div class="sh-player">
        <%= render 'slides/slide_horizontal', slide: @slide, start_position: @start_position, prefix: prefix %>
      </div>
    <% end %>
  </div>
</section>

<div class="container sh-slide-body">
  <div class="row g-5">
    <div class="col-lg-8">
      <h1 class="sh-slide-title"><%= strip_tags @slide.name %></h1>

      <div class="sh-byline">
        <%= user_avatar_tag(@slide.user, size: 44) %>
        <div>
          <%= link_to strip_tags(@slide.user.display_name), user_by_username_path(username: @slide.user.username), class: 'sh-byline-name' %>
          <div class="sh-byline-meta">
            <%= compact_date(@slide.created_at) %>
            <%= link_to @slide.category_name, category_path(@slide.category_id) %>
            <% if @slide.private %><span class="badge text-bg-secondary"><%= t(:private_slide) %></span><% end %>
          </div>
        </div>
      </div>

      <div class="sh-slide-stats">
        <div class="sh-stat">
          <span class="sh-stat-value"><%= number_with_delimiter(@slide.total_view) %></span>
          <span class="sh-stat-label"><%= t(:stat_views) %></span>
        </div>
        <div class="sh-stat">
          <span class="sh-stat-value"><%= number_with_delimiter(@slide.embedded_view) %></span>
          <span class="sh-stat-label"><%= t(:stat_embedded_views) %></span>
        </div>
        <% if @slide.downloadable %>
        <div class="sh-stat">
          <span class="sh-stat-value"><%= number_with_delimiter(@slide.download_count) %></span>
          <span class="sh-stat-label"><%= t(:stat_downloads) %></span>
        </div>
        <% end %>
        <div class="sh-stat">
          <span class="sh-stat-value"><%= number_with_delimiter(@slide.num_of_pages) %></span>
          <span class="sh-stat-label"><%= t(:stat_pages) %></span>
        </div>
      </div>

      <div class="sh-actions">
        <% if @slide.downloadable %>
          <%= link_to slide_download_path(@slide.id), class: 'btn btn-primary' do %><i class="fa fa-download" aria-hidden="true"></i><%= t(:action_download) %><% end %>
        <% end %>
        <%= link_to '#', id: 'show_embedded', class: 'btn btn-sh-quiet', data: { toggle: 'modal', target: 'embedded_dialog' } do %><i class="fa fa-code" aria-hidden="true"></i><%= t(:action_embed) %><% end %>
        <% if vertical %>
          <%= link_to slide_path(@slide.id), class: 'btn btn-sh-quiet' do %><i class="fa fa-play" aria-hidden="true"></i><%= t(:action_normal_view) %><% end %>
        <% else %>
          <%= link_to slide_path(@slide.id, vertical: 1), class: 'btn btn-sh-quiet' do %><i class="fa fa-bars" aria-hidden="true"></i><%= t(:action_vertical_view) %><% end %>
        <% end %>
        <%= render 'slides/share_buttons' %>
        <% if owner %>
          <%= link_to edit_slide_path(@slide.id), class: 'btn btn-sh-quiet' do %><i class="fa fa-pen" aria-hidden="true"></i><%= t(:action_edit) %><% end %>
          <%= link_to slide_path(@slide.id), method: :delete, data: { confirm: t(:confirm_delete_slide) }, class: 'btn btn-outline-danger' do %><i class="fa fa-trash" aria-hidden="true"></i><%= t(:action_delete) %><% end %>
        <% end %>
      </div>

      <% if @slide.description.present? %>
        <div class="sh-description"><%= simple_format(h(@slide.description)) %></div>
      <% end %>

      <% if @slide.tags.any? %>
        <ul class="sh-tags" aria-label="<%= t('activerecord.models.tag') %>">
          <% @slide.tags.each do |tag| %>
            <li><%= link_to tag, search_index_path(q: { tag_search: tag.to_s }), class: 'sh-tag' %></li>
          <% end %>
        </ul>
      <% end %>

      <%# カスタムコンテンツ「右上」は、タグの直後に出す %>
      <% if ApplicationSetting['custom_content.right_top'].present? %>
        <div class="sh-custom-right-top"><%= render 'shared/custom_content_right_top' %></div>
      <% end %>
    </div>

    <aside class="col-lg-4">
      <% if @related_slides.any? %>
        <h2 class="sh-aside-title"><%= t(:related_slides) %></h2>
        <div class="sh-related">
          <%# 右の列が左の情報より長くなりすぎないよう、6件まで %>
          <% @related_slides.first(6).each do |slide| %>
            <%= render 'slides/slide_compact', slide: slide %>
          <% end %>
        </div>
      <% end %>
    </aside>
  </div>

  <%# 文字起こしとコメントは全幅 %>
  <section class="sh-section" aria-labelledby="transcript-heading">
    <div class="sh-section-head"><h2 id="transcript-heading"><%= t(:transcript) %></h2></div>
    <%= render 'slides/transcript', slide: @slide, prefix: prefix %>
  </section>

  <section class="sh-section" aria-labelledby="comments-heading">
    <div class="sh-section-head"><h2 id="comments-heading"><%= t 'activerecord.models.comment' %></h2></div>
    <%= render 'slides/comment', comment: @comment, posted_comments: @posted_comments %>
  </section>
</div>

<%= render 'slides/embedded_dialog', slide: @slide %>
