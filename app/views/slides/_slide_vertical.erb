<% page_list = slide.pages.list %>
<%
if page_list.instance_of?(Array)
  page_count = page_list.count
else
  page_count = 0
end
%>
<% if page_count > 0 %>
<% count = 0 %>
<% page_list.each do |f| %>
<% count +=1 %>
<% u = "#{CloudConfig::provider.resource_endpoint}/#{f}" %>
<% page_alt = "#{strip_tags(slide.name)} (#{count}/#{page_count})" %>
<div class="vertical_slide_box">
  <a name="img-<%= count-1 %>"></a>
  <%# 最初の2枚はすぐに読み込み、3枚目以降はブラウザの遅延読み込みに任せる %>
  <%= image_tag u, class: "img-fluid", style: "width:100%", alt: page_alt, loading: (count <= 2 ? "eager" : "lazy") %>
</div>
<div class="icon_right">
<a href="#top"><i class="fa fa-arrow-up"></i></a>
</div>
<% end %>
<% elsif slide.convert_error? %>
    <%= image_tag "failed_to_convert.jpg", class: "img-fluid" %>
<% else %>
    <%= image_tag "converting.jpg", class: "img-fluid" %>
<% end %>
