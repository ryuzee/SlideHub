<div class="mb-4"></div>
<% content_for :title, t(:edit_slide) %>

<%# 差し替えるファイルは新しいキーに上げる。URL が変わるので、CDN に古い画像が残っても表示されない %>
<%= render :partial => 'slides/azure/upload_js', :locals => { :command => 'edit', :rand_name => Slide.generate_object_key } %>

<div class="row">
    <div class="col-md-8">
    <h3><%= t(:edit_slide) %></h3>

    <div class="card card-default">
    <div class="card-body">

    <form id="upload-form" method="post" enctype="multipart/form-data" action="javascript:void(0); return false;">

    <div class="mb-3">
      <label class="form-label col-sm-2"><%= t(:file) %></label>
      <div class="col-sm-10">
        <input type="file" name="file" id="file" class="form-control" accept="application/pdf,.pdf" />
      </div>
    </div>

    <div class="mb-3">
      <label class="form-label col-sm-2"></label>
      <div class="col-sm-10">
        <div class="progress">
          <div class="progress-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" style="width: 0%;"></div>
        </div>
      </div>
    </div>

    <div class="mb-3">
      <div class="col-sm-10">
        <input type="submit" id="re-upload" class="btn btn-primary" value="<%= t :re_upload_slide %>" />
      </div>
    </div>

</form>

<%= form_for @slide, :html => { :class => "slide" } do |f| %>

    <% if @slide.errors.any? %>
    <div id="error_expl" class="card card-danger">
      <div class="card-heading">
        <h3 class="card-title"><%= t('error_save_slide', errors: @slide.errors.count) %></h3>
      </div>
      <div class="card-body">
        <ul>
        <% @slide.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, :class => 'form-label col-sm-2' %>
    <div class="col-sm-10">
      <%= f.text_field :name, :class => 'form-control' %>
      <%= errors(@slide, :name) %>
    </div>

  </div>
  <div class="mb-3">
    <%= f.label :description, :class => 'form-label col-sm-2' %>
    <div class="col-sm-10">
      <%= f.text_area :description, :class => 'form-control' %>
      <%= errors(@slide, :description) %>
    </div>
  </div>

  <div class="mb-3">
    <div class="col-sm-10">
      <div class="form-check">
        <%= f.check_box :downloadable, class: "form-check-input" %>
        <%= f.label :downloadable, t('activerecord.attributes.slide.downloadable'), class: "form-check-label" %>
      </div>
      <%= errors(@slide, :downloadable) %>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label t('activerecord.models.category'), :class => 'form-label col-sm-2' %>
    <div class="col-sm-10">
      <%= f.collection_select :category_id, Category.all, :id, :name, {prompt: "Select a category"}, {class: 'form-select'} %>
      <%= errors(@slide, :category_id) %>
    </div>
  </div>

  <%= f.hidden_field :id, :value => @slide.id %>
  <%= f.hidden_field :object_key, :id => 'SlideKey', :value => @slide.object_key %>
  <div class="mb-3">
    <%= f.label t('activerecord.models.tag'), :class => 'form-label col-sm-2' %>
    <div class="col-sm-10">
      <%= f.text_field :tag_list, :value => @slide.tag_list.join(','), :class => 'form-control' %>
      <%= errors(@slide, :tag_list) %>
    </div>
  </div>

  <div class="mb-3">
    <div class="col-sm-10">
      <div class="form-check">
        <%= f.check_box :private, class: "form-check-input" %>
        <%= f.label :private, t('activerecord.attributes.slide.private'), class: "form-check-label" %>
      </div>
      <%= errors(@slide, :private) %>
    </div>
  </div>

  <%= f.submit nil, :id => 'save_button', :class => 'btn btn-primary' %>
  <%= link_to t("helpers.links.cancel"), slides_path, :class => 'btn btn-outline-secondary' %>

<% end %>

    </div>
    </div>
    </div>

    <div class="col-md-4">
    <%= render 'users/right_side_bar', user: current_user %>
    </div>

</div>
