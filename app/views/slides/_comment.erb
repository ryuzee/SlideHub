<% if posted_comments.empty? %>
  <p class="sh-empty"><%= t(:no_comments) %></p>
<% else %>
  <% posted_comments.each do |c| %>
    <div class="sh-comment">
      <%= user_avatar_tag(c.user, size: 40) %>
      <div>
        <div class="sh-comment-head">
          <a href="<%= user_by_username_path(username: c.user.username) %>"><%= strip_tags c.user.display_name %></a>
          <%= compact_date(c.created_at) %>
          <% if user_signed_in? && current_user.id == c.user_id %>
            <%= link_to t(:delete), "/comments/#{c.id}", method: :delete, data: { confirm: t(:confirm_delete_comment) }, class: 'link-danger small' %>
          <% end %>
        </div>
        <div><%= strip_tags c.comment %></div>
      </div>
    </div>
  <% end %>
<% end %>

<% if user_signed_in? %>
  <div class="comments form mt-3">
    <%= render :partial => 'comments/form', :locals => { :comment => comment } %>
  </div>
<% end %>
