<%= admin_page_header(section: link_to(t(:custom_pages), admin_pages_path)) do %><%= t('custom_pages') %><% end %>

<section class="content">

  <div class="card card-warning card-outline">
    <div class="card-header">
      <h3 class="card-title">&nbsp;</h3>
      <div class="card-tools">
        <div class="input-group input-group-sm text-end">
          <div class="input-group-btn">
            <%= link_to t(:new_page), new_admin_page_path, class: 'btn btn-primary' %>
          </div>
        </div>
      </div>
    </div>
    <div class="card-body p-0">
      <!-- Table -->
      <% if @pages.empty? %>
        <%= render 'admin/shared/empty', message: t(:no_pages), icon: 'fa-file-lines' %>
      <% else %>
      <table class="table table-striped small">
        <thead>
          <tr>
            <th class="col-md-1"><%= sort_link(@search, :id) %></th>
            <th class="col-md-2"><%= sort_link(@search, :path) %></th>
            <th class="col-md-4"><%= sort_link(@search, :title) %></th>
            <th class="col-md-2"><%= sort_link(@search, :created_at) %></th>
            <th class="col-md-2"><%= sort_link(@search, :updated_at) %></th>
            <th class="col-md-1 text-end"><%= t(:operation) %></th>
          </tr>
        </thead>
        <tbody>
          <% @pages.each do |page| %>
            <tr>
              <td><%= page.id %></td>
              <td><%= page.path %></td>
              <td><%= link_to page.title, edit_admin_page_path(page.id), class: 'fw-semibold' %></td>
              <td><%= page.created_at %></td>
              <td><%= page.updated_at %></td>
              <td class="text-end text-nowrap">
                <%= link_to t(:edit), edit_admin_page_path(page.id), class: 'btn btn-primary btn-sm' %>
                <%= link_to static_page_path(path: page.path), class: 'btn btn-outline-secondary btn-sm', target: '_blank', rel: 'noopener', title: t(:open_public_page), aria: { label: t(:open_public_page) } do %><i class="fa fa-arrow-up-right-from-square"></i><% end %>
                <%= button_to t(:delete), admin_page_path(page.id), method: :delete, class: 'btn btn-outline-danger btn-sm', form_class: 'd-inline', data: { confirm: t(:confirm_to_delete) } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% end %>
    </div>

    <div>
      <%= will_paginate @pages, :renderer => WillPaginate::ActionView::BootstrapLinkRenderer %>
    </div>
  </div>

</section>
