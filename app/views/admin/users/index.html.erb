<%= admin_page_header(section: link_to(t('activerecord.models.user'), admin_users_path)) do %><%= t('activerecord.models.user') %><% end %>

<section class="content">
<%= search_form_for @search, url: admin_users_path, html: { class: 'slide mb-3' } do |f| %>
  <div class="card">
    <div class="card-body">
      <div class="d-flex flex-wrap gap-2 align-items-center">
        <div class="flex-grow-1" style="max-width: 28rem;">
          <%= f.search_field :email_cont, class: 'form-control', placeholder: t('activerecord.attributes.user.email'), aria: { label: t('activerecord.attributes.user.email') } %>
        </div>
        <%= f.submit t(:search), class: 'btn btn-primary' %>
        <button class="btn btn-link text-decoration-none" type="button" data-bs-toggle="collapse" data-bs-target="#user-advanced-search" aria-expanded="<%= advanced_search_used?(%w[email_cont s]) %>" aria-controls="user-advanced-search">
          <i class="fa fa-sliders me-1"></i><%= t(:advanced_search) %>
        </button>
      </div>

      <div class="collapse<%= ' show' if advanced_search_used?(%w[email_cont s]) %>" id="user-advanced-search">
        <div class="row g-3 pt-3">
          <div class="col-md-3">
            <%= f.label :username_cont, t('activerecord.attributes.user.username'), class: 'form-label' %>
            <%= f.search_field :username_cont, class: 'form-control' %>
          </div>
          <div class="col-md-3">
            <%= f.label :display_name_cont, t('activerecord.attributes.user.display_name'), class: 'form-label' %>
            <%= f.search_field :display_name_cont, class: 'form-control' %>
          </div>
          <div class="col-md-3">
            <%= f.label :provider_cont, t('activerecord.attributes.user.provider'), class: 'form-label' %>
            <%= f.search_field :provider_cont, class: 'form-control' %>
          </div>
          <div class="col-md-3">
            <span class="form-label d-block"><%= t('activerecord.attributes.user.admin') %></span>
            <div class="form-check pt-2">
              <%= f.check_box :admin_true, { class: 'form-check-input' }, 1, nil %>
              <%= f.label :admin_true, t(:admin_only), class: 'form-check-label' %>
            </div>
          </div>
          <div class="col-md-3" style="position: relative">
            <%= f.label :created_at_gteq, t('registered_date_from'), class: 'form-label' %>
            <div class="input-group datetimepicker" id="datetimepicker1">
              <% v = (request.query_parameters.has_key?(:q) and request.query_parameters[:q].has_key?(:created_at_gteq)) ? request.query_parameters[:q][:created_at_gteq] : "" %>
              <%= f.text_field :created_at_gteq, data: { date_format: 'YYYY/MM/DD HH:mm' }, class: 'form-control', placeholder: 'YYYY/MM/DD HH:mm', value: v %>
              <span class="input-group-text" id="date1"><i class="fa fa-calendar"></i></span>
            </div>
          </div>
          <div class="col-md-3" style="position: relative">
            <%= f.label :created_at_lteq, t('registered_date_to'), class: 'form-label' %>
            <div class="input-group datetimepicker" id="datetimepicker2">
              <% v = (request.query_parameters.has_key?(:q) and request.query_parameters[:q].has_key?(:created_at_lteq)) ? request.query_parameters[:q][:created_at_lteq] : "" %>
              <%= f.text_field :created_at_lteq, data: { date_format: 'YYYY/MM/DD HH:mm' }, class: 'form-control', placeholder: 'YYYY/MM/DD HH:mm', value: v %>
              <span class="input-group-text" id="date2"><i class="fa fa-calendar"></i></span>
            </div>
          </div>
          <div class="col-md-3 d-flex align-items-end">
            <%= f.button t(:reset), class: 'btn btn-outline-secondary', id: 'reset' %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>

<%= render 'shared/reset' %>

<div class="card">
  <% if @users.empty? %>
    <%= render 'admin/shared/empty', message: t(:no_users_found), icon: 'fa-user' %>
  <% else %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 admin-list-table">
        <thead>
          <tr>
            <th><%= sort_link(@search, :display_name) %></th>
            <th><%= sort_link(@search, :email) %></th>
            <th><%= sort_link(@search, :admin) %></th>
            <th class="num"><%= sort_link(@search, :slides_count) %></th>
            <th class="num"><%= sort_link(@search, :sign_in_count) %></th>
            <th><%= sort_link(@search, :last_sign_in_at) %></th>
            <th class="text-end"><%= t('command') %></th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td>
                <div class="d-flex align-items-center">
                  <% if user.avatar.attached? %>
                    <%= image_tag url_for(user.avatar), size: '32x32', class: 'rounded-circle me-2', alt: '' %>
                  <% else %>
                    <%= image_tag 'avatar/thumb/missing.png', size: '32x32', class: 'rounded-circle me-2', alt: '' %>
                  <% end %>
                  <div>
                    <%= link_to user.display_name, edit_admin_user_path(user.id), class: 'fw-semibold' %>
                    <div class="small text-body-secondary">#<%= user.id %> · @<%= user.username %><% if user.provider.present? %> · <%= user.provider %><% end %></div>
                  </div>
                </div>
              </td>
              <td class="small"><%= user.email %></td>
              <td><% if user.admin %><span class="badge text-bg-primary"><%= t('activerecord.attributes.user.admin') %></span><% end %></td>
              <td class="num"><%= number_with_delimiter(user.slides_count) %></td>
              <td class="num"><%= number_with_delimiter(user.sign_in_count) %></td>
              <td class="small"><%= user.last_sign_in_at.to_formatted_s(:default) if user.last_sign_in_at %></td>
              <td class="text-end text-nowrap">
                <%= link_to t(:edit), edit_admin_user_path(user.id), class: 'btn btn-primary btn-sm' %>
                <%= link_to user_by_username_path(username: user.username), class: 'btn btn-outline-secondary btn-sm', target: '_blank', rel: 'noopener', title: t(:open_public_page), aria: { label: t(:open_public_page) } do %><i class="fa fa-arrow-up-right-from-square"></i><% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

<div class="mt-3">
  <%= will_paginate @users, renderer: WillPaginate::ActionView::BootstrapLinkRenderer %>
</div>
</section>

<script type="text/javascript">
$(function(){
  var td1 = new tempusDominus.TempusDominus(
    document.getElementById('datetimepicker1'),
    {
      localization: {locale: 'ja', hourCycle: 'h23'},
      display: {sideBySide: true},
    }
  ) ;
  td1.dates.formatInput = function(date) { {return moment(date).format('YYYY/MM/DD HH:mm') } }
  td1.dates.parseInput = function(value) {  {return moment(value, 'YYYY/MM/DD HH:mm').toDate(); }}

  var td2 = new tempusDominus.TempusDominus(
    document.getElementById('datetimepicker2'),
    {
      localization: {locale: 'ja', hourCycle: 'h23'},
      display: {sideBySide: true},
    }
  ) ;
  td2.dates.formatInput = function(date) { {return moment(date).format('YYYY/MM/DD HH:mm') } }
  td2.dates.parseInput = function(value) {  {return moment(value, 'YYYY/MM/DD HH:mm').toDate(); }}
});
</script>
