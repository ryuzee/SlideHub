<%= admin_page_header(section: link_to(t('activerecord.models.slide'), admin_slides_path)) do %><%= t("activerecord.models.slide") %><% end %>

<section class="content">
<%= search_form_for @search, url: admin_slides_path, html: { class: 'slide mb-3' } do |f| %>
  <div class="card">
    <div class="card-body">
      <div class="d-flex flex-wrap gap-2 align-items-center">
        <div class="flex-grow-1" style="max-width: 28rem;">
          <%= f.search_field :name_cont, class: 'form-control', placeholder: t('activerecord.attributes.slide.name'), aria: { label: t('activerecord.attributes.slide.name') } %>
        </div>
        <%= f.submit t(:search), class: 'btn btn-primary' %>
        <button class="btn btn-link text-decoration-none" type="button" data-bs-toggle="collapse" data-bs-target="#slide-advanced-search" aria-expanded="<%= advanced_search_used?(%w[name_cont s]) %>" aria-controls="slide-advanced-search">
          <i class="fa fa-sliders me-1"></i><%= t(:advanced_search) %>
        </button>
        <div class="ms-auto">
          <a href="<%= admin_slides_path %>.csv?<%= request.query_string %>" class="btn btn-outline-secondary"><i class="fa fa-download me-1"></i>CSV</a>
        </div>
      </div>

      <div class="collapse<%= ' show' if advanced_search_used?(%w[name_cont s]) %>" id="slide-advanced-search">
        <div class="row g-3 pt-3">
          <div class="col-md-3">
            <%= f.label :description_cont, t('activerecord.attributes.slide.description'), class: 'form-label' %>
            <%= f.search_field :description_cont, class: 'form-control' %>
          </div>
          <div class="col-md-3">
            <%= f.label :user_display_name_cont, t(:slide_author), class: 'form-label' %>
            <%= f.search_field :user_display_name_cont, class: 'form-control' %>
          </div>
          <div class="col-md-3">
            <%= f.label :tag_search, t('activerecord.models.tag'), class: 'form-label' %>
            <% v = (request.query_parameters.has_key?(:q) and request.query_parameters[:q].has_key?(:tag_search)) ? request.query_parameters[:q][:tag_search] : "" %>
            <%= f.text_field :tag_search, value: v, class: 'form-control' %>
          </div>
          <div class="col-md-3">
            <%= f.label :convert_status_eq, t('activerecord.attributes.slide.convert_status'), class: 'form-label' %>
            <%= f.select :convert_status_eq, Slide.convert_statuses.map { |k, v| [t("enums.slide.convert_status.#{k}"), v] }, { include_blank: true }, { class: 'form-select' } %>
          </div>
          <div class="col-md-3" style="position: relative">
            <%= f.label :created_at_gteq, t('published_date_from'), class: 'form-label' %>
            <div class="input-group datetimepicker" id="datetimepicker1">
              <% v = (request.query_parameters.has_key?(:q) and request.query_parameters[:q].has_key?(:created_at_gteq)) ? request.query_parameters[:q][:created_at_gteq] : "" %>
              <%= f.text_field :created_at_gteq, data: { date_format: 'YYYY/MM/DD HH:mm' }, class: 'form-control', placeholder: 'YYYY/MM/DD HH:mm', value: v %>
              <span class="input-group-text" id="date1"><i class="fa fa-calendar"></i></span>
            </div>
          </div>
          <div class="col-md-3" style="position: relative">
            <%= f.label :created_at_lteq, t('published_date_to'), class: 'form-label' %>
            <div class="input-group datetimepicker" id="datetimepicker2">
              <% v = (request.query_parameters.has_key?(:q) and request.query_parameters[:q].has_key?(:created_at_lteq)) ? request.query_parameters[:q][:created_at_lteq] : "" %>
              <%= f.text_field :created_at_lteq, data: { date_format: 'YYYY/MM/DD HH:mm' }, class: 'form-control', placeholder: 'YYYY/MM/DD HH:mm', value: v %>
              <span class="input-group-text" id="date2"><i class="fa fa-calendar"></i></span>
            </div>
          </div>
          <div class="col-md-3">
            <span class="form-label d-block"><%= t('activerecord.attributes.slide.downloadable') %></span>
            <div class="form-check pt-2">
              <%= f.check_box :downloadable_true, { class: 'form-check-input' }, 1, nil %>
              <%= f.label :downloadable_true, t(:downloadable_only), class: 'form-check-label' %>
            </div>
          </div>
          <div class="col-md-3 d-flex align-items-end">
            <%= f.button t(:reset), class: 'btn btn-outline-secondary', id: 'reset' %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>

<%= render 'shared/reset' %>

<div class="card">
  <% if @slides.empty? %>
    <%= render 'admin/shared/empty', message: t(:no_slides_found), icon: 'fa-file' %>
  <% else %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 admin-list-table">
        <thead>
          <tr>
            <th style="width: 112px;"></th>
            <th><%= sort_link(@search, :name) %></th>
            <th><%= sort_link(@search, :convert_status) %></th>
            <th class="num"><%= sort_link(@search, :total_view) %></th>
            <th><%= sort_link(@search, :updated_at) %></th>
            <th class="text-end"><%= t('command') %></th>
          </tr>
        </thead>
        <tbody>
          <% @slides.each do |slide| %>
            <tr>
              <td><%= link_to slide_thumbnail_tag(slide, class: 'admin-thumbnail'), edit_admin_slide_path(slide.id) %></td>
              <td>
                <%= link_to slide.name, edit_admin_slide_path(slide.id), class: 'fw-semibold' %>
                <div class="small text-body-secondary">
                  #<%= slide.id %> · <%= slide.user_display_name %> · <%= slide.created_at.to_formatted_s(:default) if slide.created_at %>
                  <% if slide.private %><span class="badge text-bg-light border ms-1"><%= t('activerecord.attributes.slide.private') %></span><% end %>
                </div>
              </td>
              <td><%= slide_status_badge(slide) %></td>
              <td class="num"><%= number_with_delimiter(slide.total_view) %></td>
              <td class="small"><%= slide.updated_at.to_formatted_s(:default) if slide.updated_at %></td>
              <td class="text-end text-nowrap">
                <%= link_to t(:edit), edit_admin_slide_path(slide.id), class: 'btn btn-primary btn-sm' %>
                <div class="btn-group">
                  <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false" aria-label="<%= t(:more_actions) %>">
                    <i class="fa fa-ellipsis"></i>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end">
                    <li><%= link_to slide_path(slide.id), class: 'dropdown-item', target: '_blank', rel: 'noopener' do %><i class="fa fa-arrow-up-right-from-square fa-fw me-2"></i><%= t(:open_public_page) %><% end %></li>
                    <li><%= link_to admin_slide_download_path(slide.id), class: 'dropdown-item' do %><i class="fa fa-download fa-fw me-2"></i><%= t(:download) %><% end %></li>
                    <li><a class="dropdown-item" href="<%= slide.transcript.url %>" target="_blank" rel="noopener noreferrer"><i class="fa fa-file-lines fa-fw me-2"></i><%= t(:transcript) %></a></li>
                    <li><a class="dropdown-item" href="<%= slide.pages.url %>" target="_blank" rel="noopener noreferrer"><i class="fa fa-list fa-fw me-2"></i><%= t(:page_list_json) %></a></li>
                    <% if slide.converted? && !slide.private %>
                      <li><%= button_to admin_featured_slides_path, method: :post, params: { 'featured_slide[slide_id]' => slide.id }, class: 'dropdown-item', form_class: 'd-block' do %><i class="fa fa-star fa-fw me-2"></i><%= t(:add_to_featured) %><% end %></li>
                    <% end %>
                    <li><hr class="dropdown-divider"></li>
                    <li><%= link_to admin_slide_reconvert_path(slide.id), class: 'dropdown-item', data: { confirm: t(:confirm_to_send_reconvert_request) } do %><i class="fa fa-rotate fa-fw me-2"></i><%= t(:reconvert) %><% end %></li>
                  </ul>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

<div class="mt-3">
  <%= will_paginate @slides, renderer: WillPaginate::ActionView::BootstrapLinkRenderer %>
</div>
</section>

<script type="text/javascript">
$(function(){
  var td1 = new tempusDominus.TempusDominus(
    document.getElementById('datetimepicker1'),
    {
      localization: {locale: 'ja'},
      display: {sideBySide: true, components: {useTwentyfourHour:true}},
    }
  ) ;
  td1.dates.formatInput = function(date) { {return moment(date).format('YYYY/MM/DD HH:mm') } }
  td1.dates.parseInput = function(value) {  {return moment(value, 'YYYY/MM/DD HH:mm').toDate(); }}

  var td2 = new tempusDominus.TempusDominus(
    document.getElementById('datetimepicker2'),
    {
      localization: {locale: 'ja'},
      display: {sideBySide: true, components: {useTwentyfourHour:true}},
    }
  ) ;
  td2.dates.formatInput = function(date) { {return moment(date).format('YYYY/MM/DD HH:mm') } }
  td2.dates.parseInput = function(value) {  {return moment(value, 'YYYY/MM/DD HH:mm').toDate(); }}
});
</script>
