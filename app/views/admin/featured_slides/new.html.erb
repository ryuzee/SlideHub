<%= admin_page_header(section: link_to(t(:featured_slides), admin_featured_slides_path)) do %><%= t(:featured_slides) %><% end %>

<section class="content">


<%= form_for @featured_slide, :html => { :class => "form-horizontal slide" }, :url => admin_featured_slides_path  do |f| %>

  <div class="control-group">
    <%= f.label :slide_id, :class => 'form-label' %>
    <div class="controls">
      <%= f.text_field :slide_id, :class => 'form-control' %>
    </div>
    <%= errors(@featured_slide, :slide_id) %>
  </div>

  <br clear="all" />

  <%= f.submit t('add'), :class => 'btn btn-primary' %>

<% end %>
</section>
