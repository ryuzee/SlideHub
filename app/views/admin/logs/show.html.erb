<%= admin_page_header(section: link_to(t(:logs), admin_logs_index_path)) do %><%= @path %>&nbsp;<%= t(:last_lines) %>&nbsp;&nbsp;<small><%= link_to(t(:download), admin_logs_download_path + "?path=#{@path}")%></small><% end %>

<section class="content">

<div class="card card-danger card-outline">
  <div class="card-body small">
    <% @result.each do |line| %>
    <%= raw line %><br />
    <% end %>
  </div>
</div>
</section>
