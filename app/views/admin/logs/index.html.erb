<%= admin_page_header(section: link_to(t(:logs), admin_logs_index_path)) do %><%= t(:logs) %><% end %>

<section class="content">

<div class="card card-danger card-outline">
  <div class="card-body p-0">
  <!-- Table -->
  <table class="table table-striped small">
    <thead>
      <tr>
        <th class="col-md-12"><%= t(:path) %></th>
      </tr>
    </thead>
    <tbody>
      <% @files.each do |f| %>
      <tr>
        <td><%= link_to f, "#{admin_logs_show_path}?path=#{f}" %></td>
      </tr>
      <% end %>
    </tbody>
  </table>
</div>
</div>
</section>
