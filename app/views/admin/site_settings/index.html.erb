<%= admin_page_header(section: link_to(t(:site_settings), admin_site_settings_path)) do %><%= t(:site_settings) %><% end %>

<section class="content">

<%= form_tag update_admin_site_settings_path, method: :post, class: 'slide' do %>
  <% index = 0 %>
  <% grouped_settings(@settings).each do |group, settings| %>
    <div class="card mb-3">
      <div class="card-header"><h3 class="card-title"><%= t("setting_groups.#{group}") %></h3></div>
      <div class="list-group list-group-flush">
        <% settings.each do |setting| %>
          <%# 行ごとに番号を付ける（スイッチの hidden と checkbox が同じ設定として送られるように） %>
          <%= fields_for("settings[#{index}]", setting) do |fh| %>
            <div class="list-group-item py-3">
              <%= fh.hidden_field :var %>
              <div class="row g-2 align-items-center">
                <div class="col-md-5">
                  <label class="form-label fw-semibold mb-0" for="<%= setting_field_id(setting) %>"><%= t(setting.var) %></label>
                  <% description = t("setting_descriptions.#{setting.var}", default: '') %>
                  <% if description.present? %><div class="small text-body-secondary"><%= description %></div><% end %>
                </div>
                <div class="col-md-7">
                  <% if boolean_setting?(setting) %>
                    <div class="form-check form-switch fs-5 mb-0"><%= generate_form_field(setting, fh) %></div>
                  <% else %>
                    <%= generate_form_field(setting, fh) %>
                  <% end %>
                  <% if setting.var == 'site.theme' %>
                    <div class="d-flex flex-wrap gap-3 mt-2 small text-body-secondary">
                      <% SettingsHelper::THEMES.each do |theme, color| %>
                        <span class="d-inline-flex align-items-center"><span class="d-inline-block rounded-circle border me-1" style="width: 14px; height: 14px; background: <%= color %>;"></span><%= theme %></span>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
          <% index += 1 %>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="mb-4">
    <%= submit_tag t(:save_settings), class: 'btn btn-primary' %>
  </div>
<% end %>

<div class="card card-secondary card-outline mt-4">
  <div class="card-body">
    <h3 class="h5 mb-2"><%= t(:regenerate_thumbnails) %></h3>
    <p class="text-muted small mb-3"><%= t(:regenerate_thumbnails_description) %></p>
    <%= button_to t(:regenerate_thumbnails), admin_thumbnail_regeneration_path, method: :post,
                  class: 'btn btn-outline-secondary', data: { confirm: t(:regenerate_thumbnails_confirm) } %>

    <%# 進捗はキューの残り件数からの概算。一括再生成を一度でも実行していれば表示する %>
    <div id="thumbnail-regeneration-progress" class="mt-3 d-none"
         data-url="<%= admin_thumbnail_regeneration_path(format: :json) %>"
         data-text-progress="<%= t(:regenerate_thumbnails_progress) %>"
         data-text-finished="<%= t(:regenerate_thumbnails_finished) %>"
         data-text-unavailable="<%= t(:regenerate_thumbnails_unavailable) %>"
         data-text-minutes="<%= t(:regenerate_thumbnails_minutes) %>">
      <div class="progress mb-2" style="height: 1.25rem;">
        <div class="progress-bar" role="progressbar" style="width: 0%" aria-valuemin="0" aria-valuemax="100"></div>
      </div>
      <p class="small mb-0 js-progress-text"></p>
      <p class="small text-muted mb-0"><%= t(:regenerate_thumbnails_progress_note) %></p>
    </div>
  </div>
</div>

<div class="card card-secondary card-outline mt-4">
  <div class="card-body">
    <h3 class="h5 mb-2"><%= t(:bulk_reconversion) %></h3>
    <p class="text-muted small mb-2"><%= t(:bulk_reconversion_description) %></p>
    <%# 件数はスライドの表から数えるので正確。変換が終わったスライドは image_format が変わり、ここから減っていく %>
    <p class="mb-3"><%= t(:bulk_reconversion_remaining, count: @reconversion_target_count) %></p>
    <%= button_to t(:bulk_reconversion), admin_bulk_reconversion_path, method: :post,
                  class: 'btn btn-outline-secondary', disabled: @reconversion_target_count.zero?,
                  data: { confirm: t(:bulk_reconversion_confirm, count: @reconversion_target_count) } %>
  </div>
</div>

<script type="text/javascript">
  (function() {
    var box = document.getElementById('thumbnail-regeneration-progress');
    if (!box) return;
    var bar = box.querySelector('.progress-bar');
    var text = box.querySelector('.js-progress-text');

    function format(template, values) {
      return template.replace(/%\{(\w+)\}/g, function(_, key) { return values[key]; });
    }

    function render(p) {
      if (!p.requested) return false;
      box.classList.remove('d-none');
      if (p.remaining === null) {
        text.textContent = box.dataset.textUnavailable;
        return true;
      }
      var percent = p.requested_count > 0 ? Math.round(p.done * 100 / p.requested_count) : 100;
      bar.style.width = percent + '%';
      bar.setAttribute('aria-valuenow', percent);
      bar.textContent = percent + '%';
      if (p.finished) {
        bar.classList.add('bg-success');
        text.textContent = format(box.dataset.textFinished, { count: p.requested_count });
        return false;
      }
      var minutes = Math.max(1, Math.ceil(p.estimated_seconds / 60));
      text.textContent = format(box.dataset.textProgress, {
        done: p.done, count: p.requested_count, remaining: p.remaining,
        time: format(box.dataset.textMinutes, { minutes: minutes })
      });
      return true;
    }

    function poll() {
      fetch(box.dataset.url, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
        .then(function(res) { return res.json(); })
        .then(function(p) { if (render(p)) setTimeout(poll, 10000); })
        .catch(function() { setTimeout(poll, 30000); });
    }

    poll();
  })();
</script>
</section>
