<%= admin_page_header(section: link_to(t('activerecord.models.category'), admin_categories_path)) do %><%= t(:new_category) %><% end %>

<section class="content">


<%= form_for @category, :html => { :class => "form-horizontal category" }, :url => admin_categories_path do |f| %>
  <% if @category.errors.any? %>
    <div id="error_expl" class="card card-danger">
      <div class="card-heading">
        <h3 class="card-title"><%= t('error_save_category', errors: @category.errors.count) %></h3>
      </div>
      <div class="card-body">
        <ul>
          <% @category.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="control-group">
    <%= f.label :name_en, :class => 'form-label' %>
    <div class="controls">
      <%= f.text_field :name_en, :class => 'form-control' %>
    </div>
    <%= errors(@category, :name_en) %>
  </div>

  <div class="control-group">
    <%= f.label :name_ja, :class => 'form-label' %>
    <div class="controls">
      <%= f.text_field :name_ja, :class => 'form-control' %>
    </div>
    <%= errors(@category, :name_ja) %>
  </div>

  <br clear="all" />

  <%= f.submit nil, :class => 'btn btn-primary' %>
  <%= link_to t("helpers.links.cancel"), admin_categories_path, :class => 'btn btn-outline-secondary' %>

<% end %>

</section>
