<%= admin_page_header(section: link_to(t('activerecord.models.category'), admin_categories_path)) do %><%= t('activerecord.models.category') %><% end %>

<!-- Main content -->
<section class="content">
<!-- Your Page Content Here -->

<div class="card card-warning card-outline">
  <div class="card-header">
    <h3 class="card-title">&nbsp;</h3>
    <div class="card-tools">
      <div class="input-group input-group-sm text-end">
        <div class="input-group-btn">
          <%= link_to t(:new_category), new_admin_category_path, class: 'btn btn-primary' %>
        </div>
      </div>
    </div>
  </div>
  <div class="card-body p-0">
  <!-- Table -->
  <% if @categories.empty? %>
    <%= render 'admin/shared/empty', message: t(:no_categories), icon: 'fa-book' %>
  <% else %>
  <table class="table table-striped small">
    <thead>
      <tr>
        <th class="col-md-1"><%= t(:id) %></th>
        <th class="col-md-4"><%= t(:category_name_en) %></th>
        <th class="col-md-4"><%= t(:category_name_ja) %></th>
        <th class="col-md-2"><%= t(:number_of_slides) %></th>
        <th class="col-md-2"><%= t('command') %></th>
      </tr>
    </thead>
    <tbody>
      <% @categories.each do |category| %>
        <tr>
          <td><%= category.id %></td>
          <td><%= category.name_en %></td>
          <td><%= category.name_ja %></td>
          <td><%= category.slides.count %></td>
          <td>
            <%= link_to t(:edit), edit_admin_category_path(category.id), class: 'btn btn-primary btn-sm' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% end %>
  </div>
</div>
</section>
