<%= admin_page_header(section: link_to(t(:custom_files), admin_custom_files_path)) do %><%= t(:custom_files) %><% end %>

<section class="content">

<%= form_for @custom_file, :multipart => true, :html => { :class => "form-horizontal slide" }, :url => "/admin/custom_files"  do |f| %>

  <div class="control-group">
    <%= f.file_field :file, class: "form-control" %>
    <div class="mb-1"></div>

    <%= f.label t(:description), :class => 'form-label' %>
    <div class="controls">
      <%= f.text_field :description, :class => 'form-control' %>
    </div>
    <%= errors(@custom_file, :slide_id) %>
  </div>

  <br clear="all" />

  <%= f.submit t('add'), :class => 'btn btn-primary' %>

<% end %>
</section>
