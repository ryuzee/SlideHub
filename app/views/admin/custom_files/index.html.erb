<%= admin_page_header(section: link_to(t(:custom_files), admin_custom_files_path)) do %><%= t(:custom_files) %><% end %>

<section class="content">

  <div class="card card-warning card-outline">
    <div class="card-header">
      <h3 class="card-title">&nbsp;</h3>
      <div class="card-tools">
        <div class="input-group input-group-sm text-end">
          <div class="input-group-btn">
            <%= link_to t(:new_custom_file), new_admin_custom_file_path, class: 'btn btn-primary' %>
          </div>
        </div>
      </div>
    </div>
    <div class="card-body p-0">
      <!-- Table -->
      <% if @custom_files.empty? %>
        <%= render 'admin/shared/empty', message: t(:no_custom_files), icon: 'fa-upload' %>
      <% else %>
      <table class="table table-striped small">
        <thead>
          <tr>
            <th class="col-md-2"><%= t(:path) %></th>
            <th class="col-md-6">URL</th>
            <th class="col-md-2"><%= t(:description) %></th>
            <th class="col-md-2"><%= t(:operation) %></th>
          </tr>
        </thead>
        <tbody>
          <% index = 0 %>
          <% @custom_files.each do |custom_file| %>
            <tr>
              <td><%= custom_file.path %></td>
              <td><span id="<%= "file-#{index}" %>"><%= "#{CloudConfig::provider.resource_endpoint}/#{CustomFile.custom_files_directory}/#{custom_file.path}" %></span></td>
              <td><%= custom_file.description %></td>
              <td class="text-center">
                <div class="d-flex gap-2 justify-content-center">
                  <button type="button" class="btn btn-outline-secondary btn-sm copy-to-clipboard" data-clipboard-target="<%= "#file-#{index}" %>"><%= t(:copy) %></button>
                  <%= button_to t(:delete), admin_custom_file_path(custom_file.id), method: :delete, class: 'btn btn-outline-danger btn-sm', form_class: 'd-inline', data: { confirm: t(:confirm_to_delete) } %>
                </div>
              </td>
            </tr>
            <% index += 1 %>
          <% end %>
        </tbody>
      </table>
      <% end %>
    </div>
  </div>
</section>

<script type="text/javascript">
  $(document).ready(function(){
    var clipboard = new ClipboardJS('.copy-to-clipboard');
    clipboard.on('success', function(e) {
      e.clearSelection();
    });
  });
</script>
