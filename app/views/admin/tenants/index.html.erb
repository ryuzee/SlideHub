<%= admin_page_header(section: link_to(t(:tenant), admin_tenants_path)) do %><%= t('tenant') %><% end %>

<section class="content">

  <div class="card card-warning card-outline">
    <div class="card-header">
      <h3 class="card-title">&nbsp;</h3>
      <div class="card-tools">
        <div class="input-group input-group-sm text-end">
          <div class="input-group-btn">
            <%= link_to t(:new_tenant), new_admin_tenant_path, class: 'btn btn-primary' %>
          </div>
        </div>
      </div>
    </div>
    <div class="card-body p-0">
      <!-- Table -->
      <% if @tenants.empty? %>
        <%= render 'admin/shared/empty', message: t(:no_tenants), icon: 'fa-building' %>
      <% else %>
      <table class="table table-striped small">
        <thead>
          <tr>
            <th class="col-md-1"><%= t(:id) %></th>
            <th class="col-md-2"><%= t('activerecord.attributes.tenant.name') %></th>
            <th class="col-md-2"><%= t('activerecord.attributes.tenant.created_at') %></th>
            <th class="col-md-2"><%= t('activerecord.attributes.tenant.updated_at') %></th>
            <th class="col-md-1"><%= t(:operation) %></th>
          </tr>
        </thead>
        <tbody>
          <% @tenants.each do |tenant| %>
            <tr>
              <td><%= link_to tenant.id, edit_admin_tenant_path(tenant.id) %> &nbsp;</td>
              <td><%= tenant.name %></td>
              <td><%= tenant.created_at %></td>
              <td><%= tenant.updated_at %></td>
              <td>
                <%= button_to t(:delete), admin_tenant_path(tenant.id), method: :delete, class: 'btn btn-outline-danger btn-sm', form_class: 'd-inline', data: { confirm: t(:confirm_to_delete) } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% end %>
    </div>
  </div>

</section>
