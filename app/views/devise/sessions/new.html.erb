<% content_for :title, t('.sign_in') %>

<div class="sh-auth">
  <h1 class="sh-auth-title"><%= t(:signin) %></h1>

  <%= render "devise/shared/signin_with_omniauth" %>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { role: "form", class: "sh-auth-form" }) do |f| %>
    <div class="mb-3">
      <%= f.label :email, class: "form-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
    </div>
    <div class="mb-3">
      <div class="sh-auth-label-row">
        <%= f.label :password, class: "form-label" %>
        <%= render "devise/shared/forget_password" %>
      </div>
      <%= f.password_field :password, autocomplete: "current-password", class: "form-control" %>
    </div>
    <% if devise_mapping.rememberable? %>
      <div class="form-check mb-3">
        <%= f.check_box :remember_me, class: "form-check-input" %>
        <%= f.label :remember_me, class: "form-check-label" %>
      </div>
    <% end %>
    <%= f.submit t(:signin), class: "btn btn-primary w-100" %>
  <% end %>

  <%= render "devise/shared/signup_link" %>
</div>
