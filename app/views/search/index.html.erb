<% content_for :title, t(:search) %>
<% set_meta_tags noindex: true %>
<div class="sh-page-head">
  <h1><%= t :search_slides %></h1>
  <span class="sh-count"><%= t(:slides_count, count: @slides.total_entries) %></span>
</div>

<div class="sh-panel">
  <%= render 'search_form', search_q: @search %>
</div>

<% if @slides.empty? %>
  <p class="sh-empty"><%= t(:no_search_results) %></p>
<% else %>
  <%= render 'slides/thumbnail_template', slides: @slides %>
  <%= will_paginate @slides, :renderer => WillPaginate::ActionView::BootstrapLinkRenderer %>
<% end %>
