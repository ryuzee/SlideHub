<% content_for :title, @category.name %>
<% canonical category_url(@category.id) %>
<% filters = capture do %>
  <nav class="sh-chips" aria-label="<%= t(:category) %>">
    <% @categories.each do |category| %>
      <%= link_to category.name, category_path(category.id), class: "sh-tag#{' active' if category.id == @category.id}", aria: { current: (category.id == @category.id ? 'page' : nil) } %>
    <% end %>
  </nav>
<% end %>
<%= render 'slides/list_page', heading: @category.name, slides: @slides, filters: filters %>
