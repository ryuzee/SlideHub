<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Cache-Control" content="no-cache">
    <%= csrf_meta_tags %>
    <% set_meta_tags title: content_for?(:title) ? yield(:title) : "", site: ApplicationSetting['site.name'], reverse: true %>
    <%= display_meta_tags %>
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <%= favicon_link_tag 'apple-touch-icon-144x144-precomposed.png', :rel => 'apple-touch-icon-precomposed', :type => 'image/png', :sizes => '144x144' %>
    <%= favicon_link_tag 'apple-touch-icon-114x114-precomposed.png', :rel => 'apple-touch-icon-precomposed', :type => 'image/png', :sizes => '114x114' %>
    <%= favicon_link_tag 'apple-touch-icon-72x72-precomposed.png', :rel => 'apple-touch-icon-precomposed', :type => 'image/png', :sizes => '72x72' %>
    <%= favicon_link_tag 'apple-touch-icon-precomposed.png', :rel => 'apple-touch-icon-precomposed', :type => 'image/png' %>
    <%= favicon_link_tag 'favicon.ico', :rel => 'shortcut icon' %>
    <%= javascript_include_tag 'admin', 'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'admin', 'data-turbo-track': 'reload' %>
  </head>
  <body class="layout-fixed sidebar-expand-lg sidebar-mini bg-body-tertiary">
    <div class="app-wrapper">
      <nav class="app-header navbar navbar-expand bg-body">
        <div class="container-fluid">
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="Toggle sidebar"><i class="fas fa-bars"></i></a>
            </li>
            <li class="nav-item dropdown">
              <a class="nav-link bg-info text-white rounded dropdown-toggle" href="#" id="navbarVersionDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <%= current_user.display_name %>
              </a>
              <div class="dropdown-menu py-0" aria-labelledby="navbarVersionDropdown">
                <%= link_to t(:my_statistics), statistics_index_path, class: 'dropdown-item' %>
                <%= link_to t(:my_slides), user_by_username_path(username: current_user.username), class: 'dropdown-item' %>
                <div class="dropdown-divider"></div>
                <%= link_to t(:my_account), edit_user_registration_path, class: 'dropdown-item' %>
                <%= link_to t(:logout), destroy_user_session_path, method: :delete, class: 'dropdown-item' %>
              </div>
            </li>
          </ul>

          <form action="<%= admin_slides_path %>" method="get" class="d-flex ms-3" role="search">
            <div class="input-group input-group-sm">
              <input type="text" name="q[name_cont]" class="form-control" placeholder="Search..." aria-label="Search">
              <button type="submit" name="search" id="search-btn" class="btn btn-outline-secondary"><i class="fa fa-search"></i></button>
            </div>
          </form>
        </div>
      </nav>

      <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
        <div class="sidebar-brand">
          <a href="<%= admin_dashboard_path %>" class="brand-link">
            <span class="brand-text fw-light"><b><%= raw ApplicationSetting['site.name'] %></b> Console</span>
          </a>
        </div>

        <div class="sidebar-wrapper">
          <nav class="mt-2">
            <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="navigation" aria-label="Main navigation">
              <li class="nav-header"><%= t(:admin_menu) %></li>
              <li class="nav-item"><a class="nav-link<%= ' active' if controller.controller_name == 'dashboards' %>" href="<%= admin_dashboard_path %>"><i class="nav-icon fa fa-home"></i><p><%= t :admin_dashboard %></p></a></li>
              <li class="nav-item"><a class="nav-link<%= ' active' if controller.controller_name == 'slides' %>" href="<%= admin_slides_path %>"><i class="nav-icon fa fa-file"></i><p><%= t('activerecord.models.slide') %></p></a></li>
              <li class="nav-item"><a class="nav-link<%= ' active' if controller.controller_name == 'featured_slides' %>" href="<%= admin_featured_slides_path %>"><i class="nav-icon fa fa-eye"></i><p><%= t(:featured_slides) %></p></a></li>
              <li class="nav-item"><a class="nav-link<%= ' active' if controller.controller_name == 'users' %>" href="<%= admin_users_path %>"><i class="nav-icon fa fa-user"></i><p><%= t('activerecord.models.user') %></p></a></li>
              <li class="nav-item"><a class="nav-link<%= ' active' if controller.controller_name == 'categories' %>" href="<%= admin_categories_path %>"><i class="nav-icon fa fa-book"></i><p><%= t('activerecord.models.category') %></p></a></li>
              <li class="nav-item"><a class="nav-link<%= ' active' if controller.controller_name == 'custom_contents' %>" href="<%= admin_custom_contents_path %>"><i class="nav-icon fa fa-code"></i><p><%= t(:custom_contents) %></p></a></li>
              <li class="nav-item"><a class="nav-link<%= ' active' if controller.controller_name == 'pages' %>" href="<%= admin_pages_path %>"><i class="nav-icon fa fa-file-text"></i><p><%= t('custom_pages') %></p></a></li>
              <li class="nav-item"><a class="nav-link<%= ' active' if controller.controller_name == 'custom_files' %>" href="<%= admin_custom_files_path %>"><i class="nav-icon fa fa-upload"></i><p><%= t(:custom_files) %></p></a></li>
              <li class="nav-item"><a class="nav-link<%= ' active' if controller.controller_name == 'logs' %>" href="<%= admin_logs_index_path %>"><i class="nav-icon fa fa-list"></i><p><%= t(:logs) %></p></a></li>
              <li class="nav-item"><a class="nav-link<%= ' active' if controller.controller_name == 'site_settings' %>" href="<%= admin_site_settings_path %>"><i class="nav-icon fa fa-cog"></i><p><%= t(:site_settings) %></p></a></li>
              <% if Tenant.primary? %>
              <li class="nav-item"><a class="nav-link<%= ' active' if controller.controller_name == 'tenants' %>" href="<%= admin_tenants_path %>"><i class="nav-icon fa fa-building"></i><p><%= t(:tenant) %></p></a></li>
              <% end %>
              <li class="nav-header"><%= t(:public_site) %></li>
              <li class="nav-item"><a class="nav-link" href="<%= slides_path %>"><i class="nav-icon fa fa-file"></i><p><%= t('activerecord.models.slide') %></p></a></li>
              <li class="nav-item"><a class="nav-link" href="<%= popular_index_path %>"><i class="nav-icon fa fa-star"></i><p><%= t(:popular_slides) %></p></a></li>
              <li class="nav-item"><a class="nav-link" href="<%= latest_index_path %>"><i class="nav-icon fa fa-calendar"></i><p><%= t(:latest_slides) %></p></a></li>

              <li class="nav-header"><%= t(:public_site) %> by <%= t('activerecord.models.category') %></li>
              <% @categories.each do |cat| %>
                <li class="nav-item">
                <a class="nav-link" href="<%= category_path(cat.id) %>"><i class="nav-icon fa fa-circle"></i><p><%= cat.name %></p></a>
                </li>
              <% end %>
            </ul>
          </nav>
        </div>
      </aside>

      <main class="app-main">
        <div class="app-content">
          <div class="container-fluid px-4 py-2">
            <%= yield %>
          </div>
        </div>
      </main>

      <footer class="app-footer">
        <div class="float-end d-none d-sm-inline">
          Powered by <%= link_to "SlideHub", "https://github.com/ryuzee/SlideHub", target: "_blank", rel: "noopener noreferrer" %> <%= SlideHub::Version %>
        </div>
        <%= raw ApplicationSetting['site.footer'] %>
      </footer>
    </div>
  </body>
</html>
