<% content_for :title, t(:my_slides) %>
<% content_for :full_bleed, true %>
<% content_for :top_band, 'paper' %>

<%= render 'users/profile', user: @user, slides: @slides, tags: @tags, heading: t(:my_slides) %>

<div class="container site-page">
  <% if @slides.empty? %>
    <div class="sh-empty">
      <p><%= t(:no_my_slides) %></p>
      <% if (ApplicationSetting['site.only_admin_can_upload']).to_i == 0 || current_user.admin == true %>
        <%= link_to t('upload'), new_slide_path, class: 'btn btn-primary' %>
      <% end %>
    </div>
  <% else %>
    <%= render 'slides/thumbnail_template', slides: @slides %>
    <%= will_paginate @slides, :renderer => WillPaginate::ActionView::BootstrapLinkRenderer %>
  <% end %>
</div>
