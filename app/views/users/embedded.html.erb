(function() {
    var elm = document.getElementById("slidehub-<%= @prefix %>");
    elm.innerHTML = `<%= raw @body.gsub!(/\n/, '').gsub!(/ {2,}/,' ') %>`;
    // 埋め込み先のページでは application.js が無いので、ここでサムネイルの差し替えを行う
    elm.addEventListener("error", function(e) {
      var img = e.target;
      if (img.tagName === "IMG" && img.dataset.fallbackSrc && img.src !== img.dataset.fallbackSrc) {
        img.src = img.dataset.fallbackSrc;
      }
    }, true);
})();
