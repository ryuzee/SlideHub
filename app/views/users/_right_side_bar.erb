<%# アップロード・編集画面の右側に出す、投稿者のプロフィール %>
<div class="sh-panel text-center">
  <%= user_avatar_tag(user, size: 80, class: 'mb-3') %>
  <div class="fw-bold">
    <%= link_to strip_tags(user.display_name), user_by_username_path(username: user.username), class: 'sh-byline-name' %>
  </div>
  <% if user.biography.present? %>
    <p class="small text-body-secondary text-start mt-2 mb-0"><%= strip_tags user.biography %></p>
  <% end %>
</div>
