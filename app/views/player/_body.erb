<%= render 'css', prefix: prefix %>

<% default_image = asset_url("loading.jpg") %>
<div>
  <ul style="display:none" id="<%= prefix %>slide_list">
    <%= raw slide_page_image_list_tag(slide) %>
  </ul>

  <div class="<%= prefix %>slidebox" id="<%= prefix %>slidebox" style="left:0px;margin:0px;padding:0px;">
    <div id="<%= prefix %>slide_area"><img src="<%= default_image %>" /></div>
    <div id="<%= prefix %>progress_area">
      <div id="<%= prefix %>thumb">&nbsp;</div>
    </div>
    <div id="<%= prefix %>command_area">
      <div id="<%= prefix %>command_inner">
        <a class="<%= prefix %>icon" style="float:left;margin-right:4px;" href="#" id="<%= prefix %>full_screen_icon"><%= player_icon(:fullscreen, id: 'slide_control_fullscreen') %>&nbsp;</a>
        <a class="<%= prefix %>icon" style="float:left;margin-right:4px;" href="<%= slide_url(slide.id) %>"><%= player_icon(:link, id: 'slide_control_home_link') %>&nbsp;</a>
        <% if slide.downloadable %>
          <a class="<%= prefix %>icon" style="float:left;margin-right:4px;" href="<%= slide_download_url(slide.id) %>"><%= player_icon(:download, id: 'slide_control_download_link') %>&nbsp;</a>
        <% end %>
        <ul style="list-style-image:none; list-style-type:none">
          <li style="display:inline; margin:0 0px;"><a href="javascript:OSSJSPARTS<%= prefix %>.moveTo(0);">&nbsp;<%= player_icon(:first) %>&nbsp;</a></li>
          <li style="display:inline; margin:0 0px;"><a href="javascript:OSSJSPARTS<%= prefix %>.moveTo(OSSJSPARTS<%= prefix %>.currentPageIndex-1);">&nbsp<%= player_icon(:previous) %>&nbsp;</a></li>
          <li style="display:inline; margin:0 0px;"><div id="<%= prefix %>page_positions" style="padding-left:0px;"></div></li>
          <li style="display:inline; margin:0 0px;"><a href="javascript:OSSJSPARTS<%= prefix %>.moveTo(OSSJSPARTS<%= prefix %>.currentPageIndex+1);">&nbsp;<%= player_icon(:next) %>&nbsp;</a></li>
          <li style="display:inline; margin:0 0px;"><a href="javascript:OSSJSPARTS<%= prefix %>.moveTo(OSSJSPARTS<%= prefix %>.slides.length-1);">&nbsp;<%= player_icon(:last) %>&nbsp;</a></li>
        </ul>
        <span class="<%= prefix %>clearfix"></span>
      </div>
    </div>
  </div>
</div>
