(function() {
var elm = document.getElementById("slidehub-<%= @prefix %>");
elm.innerHTML = `<%= raw @body.gsub!(/\n/, '') %>`;
var s = document.createElement('script');
<%# @script は圧縮済み（PlayerScript） %>
s.innerText = `<%= raw @script %>`;
s.textContent = `<%= raw @script %>`;
elm.appendChild(s);
})();